# Salin isi ini ke Streamlit Cloud: App > Settings > Secrets (jangan commit file secrets sungguhan).

# Penyimpanan data di repositori GitHub PRIVAT terpisah (disarankan).
# Token: GitHub > Settings > Developer settings > Fine-grained tokens, izin "Contents: Read and write" hanya untuk repo data.
[github]
token = "github_pat_xxxxxxxx"
repo = "namaanda/keuangan-data"
path = "data.json"
branch = "main"

# Login. Buat hash dengan:  python buat_hash.py
# peran: admin (boleh ubah dompet, kategori, cadangan), pengisi (catat dan ubah transaksi), lihat (hanya melihat)
[users.anda]
nama = "Nama Anda"
peran = "admin"
password_hash = "pbkdf2$200000$garam$hash"

# Opsional: lama sesi login dalam jam (bawaan 8)
# sesi_jam = 8

# Opsional: baca struk otomatis dengan Claude (lebih akurat daripada Tesseract).
# Foto struk dikirim ke Anthropic dan dikenai biaya per foto. Tanpa ini, aplikasi memakai Tesseract bila terpasang.
# [anthropic]
# api_key = "sk-ant-..."
# model = "claude-sonnet-5-5"

# Opsional: cadangan mesin baca struk. Isi sebanyak yang Anda punya; dicoba berurutan
# (anthropic, openai, openrouter, gemini, lalu Tesseract) dan pindah ke berikutnya bila gagal.
# base_url dan model boleh dihapus untuk memakai bawaan. Model harus bisa membaca gambar.
# [openai]            # juga untuk gateway kompatibel OpenAI: isi base_url sampai /v1
# api_key = "..."
# base_url = "https://api.openai.com/v1"
# model = "gpt-4o-mini"
# [openrouter]
# api_key = "sk-or-..."
# model = "google/gemini-2.5-flash"
# [gemini]            # kunci dari Google AI Studio
# api_key = "..."
# model = "gemini-2.5-flash"
